# =====================================================================
# AI Data Integration & Workflow Intelligence Platform Configuration
# =====================================================================

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY=enterprise-secret-key-ai-platform-2026-super-secure-token
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Vector Database (Pinecone)
# Set to 'mock' or 'memory' for standalone local dev; or 'pinecone' for cloud production
VECTOR_STORE_BACKEND=memory
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=enterprise-knowledge-index
PINECONE_DIMENSION=768

# Embeddings & Vertex AI / Gemini
# Supported backends: 'local' (sentence-transformers), 'vertex' (Vertex AI Gecko), 'gemini' (Gemini API)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
GCP_PROJECT_ID=enterprise-intelligence-prod
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# LLM & Multi-Agent Engine
# Supported backends: 'simulation' (built-in intelligent mock engine), 'gemini', 'vertex', 'openai'
LLM_BACKEND=simulation
GEMINI_API_KEY=
OPENAI_API_KEY=

# Structured Data Warehouse (BigQuery & ERP)
# Supported backends: 'local_warehouse' (SQLite/DuckDB emulator) or 'bigquery'
WAREHOUSE_BACKEND=local_warehouse
BIGQUERY_DATASET=enterprise_analytics
ERP_DATABASE_URL=sqlite:///./data/erp/erp_system.db

# Event-Driven Messaging (Pub/Sub)
# Supported backends: 'local_async' (in-memory async queue with DLQ) or 'pubsub'
PUBSUB_BACKEND=local_async
PUBSUB_TOPIC_INGESTION=projects/enterprise-intelligence-prod/topics/data-ingestion
PUBSUB_TOPIC_WORKFLOW=projects/enterprise-intelligence-prod/topics/workflow-execution
PUBSUB_SUBSCRIPTION_NAME=projects/enterprise-intelligence-prod/subscriptions/workflow-sub
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY_SEC=1.0
RETRY_BACKOFF_FACTOR=2.0

# Evaluation & Observability
ENABLE_EXECUTION_TRACING=true
TRACING_EXPORTER=internal
EVALUATION_COST_PER_1K_PROMPT_TOKENS=0.000125
EVALUATION_COST_PER_1K_COMPLETION_TOKENS=0.000375

